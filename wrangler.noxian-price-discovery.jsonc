{
  "name": "noxian-price-discovery",
  "main": "workers/noxian-price-discovery.ts",
  "compatibility_date": "2026-05-13",
  "observability": {
    "enabled": true
  },
  "secrets_store_secrets": [
    {
      "binding": "JUSTTCG_API_KEY",
      "store_id": "0b983ec163634815a374ab0c7ed7f4eb",
      "secret_name": "JUSTTCG_API_KEY"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PRICE_STORE_INGESTION_QUEUE",
        "queue": "noxian-price-ingestion-queue"
      }
    ]
  },
  "triggers": {
    "crons": ["0 9 */2 * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxian-db",
      "database_id": "e4035dc9-7064-484a-a1b7-c80ebfcaa447",
      "migrations_dir": "price_store/migrations/d1"
    }
  ]
}
